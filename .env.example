# Annapurna — example environment file.
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
# All connectors are READ-ONLY and use the customer's own admin credentials,
# stored encrypted at rest. These are placeholders only — no real values in M0.

# --- Database (M1) ---
# Postgres, multi-tenant with row-level tenant isolation (RLS).
# DATABASE_URL is the default for both connection roles below.
DATABASE_URL=postgresql://localhost:5432/annapurna
#
# Optional split (recommended for production):
#   * ADMIN/bootstrap role owns the schema and runs migrations + seeding.
#     It bypasses RLS, so it can load data across tenants.
#   * APP role (annapurna_app) is what the running app uses; RLS is enforced
#     for it, and every request sets the tenant context.
# DATABASE_ADMIN_URL=postgresql://localhost:5432/annapurna
# DATABASE_APP_URL=postgresql://annapurna_app@localhost:5432/annapurna

# --- App secrets (M2) ---
# Used to encrypt per-tenant connector credentials at rest.
APP_SECRET_KEY=change-me-in-local-only

# --- GitHub connector (M3, read-only) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# --- Inference providers (M4, read-only Admin APIs) ---
ANTHROPIC_ADMIN_API_KEY=
OPENAI_ADMIN_API_KEY=

# --- Feature auto-discovery (M3, uses Claude over PR history) ---
# If unset, discovery falls back to a deterministic branch/repo heuristic.
ANTHROPIC_API_KEY=
# Optional: override the discovery model (default: claude-sonnet-4-6).
ANNAPURNA_DISCOVERY_MODEL=

# --- Hook ingest (M7, optional precision tier) ---
HOOK_INGEST_SIGNING_SECRET=
